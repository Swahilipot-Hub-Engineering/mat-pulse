# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed.

# ── Server Configuration ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Security & API Secrets ────────────────────────────────────────────────────
TELEMETRY_API_KEY=pwani-matatu-dev-key

# ── GTFS Agency Metadata ──────────────────────────────────────────────────────
GTFS_AGENCY_NAME="Mombasa Matatu Transit SACCOs"
GTFS_AGENCY_URL="https://swahilipothub.co.ke"
GTFS_AGENCY_TIMEZONE="Africa/Nairobi"

# ── Vehicle Tracking & Expiry ─────────────────────────────────────────────────
STALE_VEHICLE_SECONDS=300

# ── Telemetry Simulator Target ────────────────────────────────────────────────
API_URL=http://localhost:3000/api/v1/telemetry

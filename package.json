{
  "name": "mat-pulse",
  "version": "0.2.0",
  "description": "National real-time open transit telemetry engine and GTFS / GTFS-Realtime platform for Kenyan public transportation",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "simulate": "tsx src/simulator/runner.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "transit",
    "matatu",
    "gtfs",
    "gtfs-realtime",
    "telemetry",
    "mombasa",
    "kenya",
    "swahilipot",
    "gps-tracking"
  ],
  "author": "Swahilipot Hub Engineering",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "gtfs-realtime-bindings": "^2.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.19",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
